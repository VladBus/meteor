# Конфигурация meteor. Скопируйте этот файл в .env и заполните локально.
# Не добавляйте настоящий .env в Git и не отправляйте пароль в переписке.

METEOR_FTP_HOST=ftp.ntsomz.ru
METEOR_FTP_PORT=21
METEOR_FTP_USER=replace_with_ftp_username
METEOR_FTP_PASSWORD=
# "." означает текущий каталог FTP после авторизации. Укажите путь, если снимки лежат в подкаталоге.
METEOR_FTP_REMOTE_DIR=.
METEOR_FTP_TIMEOUT=60

# Сетевая папка архива
METEOR_DEST_DIR=Z:\ENVISAT\METEOP

# Маска целевых TIFF; можно изменить, если формат имени файлов изменится
METEOR_FILE_GLOB=METM24_*_BRLK_RLI_log10.tif

# Относительный путь считается от каталога проекта
METEOR_LOG_DIR=logs
