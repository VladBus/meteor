{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Meteor: main.py",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/main.py",
			"console": "integratedTerminal",
			"cwd": "${workspaceFolder}",
			"python": "${workspaceFolder}/.venv/Scripts/python.exe",
			"envFile": "${workspaceFolder}/.env",
			"justMyCode": true
		},
		{
			"name": "Meteor: Current File",
			"type": "debugpy",
			"request": "launch",
			"program": "${file}",
			"console": "integratedTerminal",
			"cwd": "${workspaceFolder}",
			"python": "${workspaceFolder}/.venv/Scripts/python.exe",
			"envFile": "${workspaceFolder}/.env",
			"justMyCode": true
		},
		{
			"name": "Meteor: Unit Tests",
			"type": "debugpy",
			"request": "launch",
			"module": "unittest",
			"args": ["discover", "-s", "tests", "-v"],
			"console": "integratedTerminal",
			"cwd": "${workspaceFolder}",
			"python": "${workspaceFolder}/.venv/Scripts/python.exe",
			"envFile": "${workspaceFolder}/.env",
			"justMyCode": false
		}
	]
}
