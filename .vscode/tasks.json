{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Meteor: Install Requirements",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": ["-m", "pip", "install", "-r", "${workspaceFolder}\\requirements.txt"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Meteor: Run main.py",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": ["${workspaceFolder}\\main.py"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": ["$python"],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Meteor: Run via BAT",
			"type": "shell",
			"command": "${workspaceFolder}\\run_meteor.bat",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Meteor: Check Python Syntax",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": ["-m", "py_compile", "${file}"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "Meteor: Run Unit Tests",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"problemMatcher": ["$python"],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		}
	]
}
